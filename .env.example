# ── Revzenta CRM Environment Configuration ──────────────────────────────
# Copy to `.env` (or export in your shell) before first run.

# Admin account. REQUIRED to use the app.
ADMIN_EMAIL=admin@revzenta.com
ADMIN_PASSWORD=change-me-to-a-strong-password

# Port the server binds.
PORT=3001

# Optional: session signing secret. If unset, a random one is generated and
# persisted to data/.secret so sessions survive restarts. Set explicitly in production.
# SESSION_SECRET=

# Set "true" when serving over HTTPS in production (sets the Secure cookie flag).
COOKIE_SECURE=false

# Database configuration:
# When DATABASE_URL is set, Revzenta connects to PostgreSQL (production standard).
# If unset, Revzenta uses local SQLite in DATA_DIR (for local offline development).
# DATABASE_URL=postgres://user:password@localhost:5432/revzenta

# Where the SQLite database file lives (used when DATABASE_URL is unset).
# DATA_DIR=./data

# AI & Property Intelligence APIs:
# Google Gemini API key for Natural Language Search Translation & Deal Explanations
# GEMINI_API_KEY=

# RentCast API key for Nationwide Property Valuations, Rent Estimates & Comps
# RENTCAST_API_KEY=

# Attom Data Solutions API key for Enterprise Ownership, Deeds, Tax, and Distress Data
# ATTOM_API_KEY=

# Google Maps Platform API key for Property Street View & Satellite Photos in the Deal Calculator.
# Required to display exterior property photos. Get a key at:
#   https://console.cloud.google.com/google/maps-apis/overview
# Enable these APIs: "Street View Static API" and "Maps Static API".
# Restrict the key to your domain in Production for security.
# Without this key the UI shows a placeholder with instructions — no errors.
# VITE_GOOGLE_MAPS_API_KEY=

# Transactional Email (Resend)
# RESEND_API_KEY=
# EMAIL_FROM=Revzenta <onboarding@resend.dev>
# TEST_EMAIL_TO=
