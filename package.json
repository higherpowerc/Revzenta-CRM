{
  "name": "revzenta-crm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Revzenta CRM — universal client pipeline management app.",
  "scripts": {
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "build:bun": "tsc --noEmit && bun build ./index.html --outdir ./dist --minify",
    "check": "bun run typecheck && bun run build",
    "start": "bun ./server/index.ts",
    "start:node": "NODE_ENV=production tsx server/index.ts",
    "dev": "cross-env PORT=3001 bun --watch ./server/index.ts",
    "dev:node": "tsx server/index.ts",
    "test": "bun test",
    "smoke": "bun test",
    "seed": "bun ./server/seed.ts",
    "db:migrate:pg": "bun ./server/db/migrate-to-pg.ts",
    "db:reset": "rm -f data/crm.db data/crm.db-shm data/crm.db-wal"
  },
  "dependencies": {
    "@google/genai": "^2.22.0",
    "@types/pg": "^8.23.1",
    "bcryptjs": "^3.0.3",
    "express": "^5.2.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "stripe": "^22.5.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/bun": "^1.2.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.1.1",
    "cross-env": "^7.0.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
